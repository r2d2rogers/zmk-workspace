/*
 * MurphPad — MACROPAD remap for zmk-workspace (Rob 2026-07-16)
 *
 * 6×5 matrix, nice!nano v1 (nRF52840), 2 encoders, WS2812 underglow.
 * Role decided: default = MACROPAD (media / window-mgmt / edit / app launch);
 * the numpad is demoted to a TOGGLE layer; a dedicated BT device-switch layer
 * handles multi-device (abbirim/spire/pacer/hackney).
 *
 * Physical layout (27 top-surface keys + 3 PCB-bottom ghosts). The shield's
 * physical_layout snakes matrix positions diagonally, so bindings below are in
 * MATRIX order with the physical @x,y annotated per key:
 *
 *         x=28    x=84    x=140   x=196   x=252
 * y=28:           [0,0]   [0,1]   [0,2]   [0,3]
 * y=84:           [0,4]   [1,0]   [1,1]   [1,2]
 * y=140:          [1,3]   [1,4]   [2,0]   [2,1]
 * y=196:  [2,2]   [2,3]   [2,4]   [3,0]e  [3,1]
 * y=252:  [3,2]   [3,3]   [3,4]   [4,0]   [4,1]
 * y=308:  [4,2]   [4,3]   [4,4]   [5,0]   [5,1]
 * y=364:          [5,2]g  [5,3]g  [5,4]g
 *
 * g=PCB bottom (ghost -> &none), e=encoder 1. Left column (x=28) = layer control.
 *
 * Layers: DEF(macropad) NUM(numpad toggle) NAV(F-keys/nav) BTL(bluetooth/device) SYS(rgb/reset)
 * Cross-OS note: window keys use LG (Meta/Win) which snap/tile on both KDE 5.27+
 * and Windows; virtual-desktop switch differs (KDE=Ctrl+Alt+arrow) — remap if
 * the pad lives on a KDE host.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define DEF 0
#define NUM 1
#define NAV 2
#define BTL 3
#define SYS 4

/* ── Encoders ─────────────────────────────────────── */
&encoder_1 { status = "okay"; };
&encoder_2 { status = "okay"; };

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1 &encoder_2>;
    };

    keymap {
        compatible = "zmk,keymap";

        /* ── DEF: Macropad ───────────────────────────────────────────── *
         *         x=28    x=84    x=140   x=196   x=252
         * y=28:           Copy    Paste   Cut     PrtSc
         * y=84:           Undo    Redo    Find    SelAll
         * y=140:          Save    ShowDsk Maximiz TaskView
         * y=196:  NUM⊤    TileL   TileR   Play    Mute
         * y=252:  NAV↓    Prev    Next    Lock    BTL↓
         * y=308:  SYS↓    Calc    Email   Web     KpEnt
         * y=364:          [g]     [g]     [g]
         * Enc1(L): volume   Enc2(R): scroll (PgUp/Dn)
         */
        default_layer {
            bindings = <
        /*  [0,0]Copy      [0,1]Paste      [0,2]Cut        [0,3]PrtSc      [0,4]Undo   */
            &kp LC(C)      &kp LC(V)       &kp LC(X)       &kp PSCRN       &kp LC(Z)
        /*  [1,0]Redo      [1,1]Find       [1,2]SelAll     [1,3]Save       [1,4]ShowDsk*/
            &kp LC(LS(Z))  &kp LC(F)       &kp LC(A)       &kp LC(S)       &kp LG(D)
        /*  [2,0]Maximize  [2,1]TaskView   [2,2]NUM-tog    [2,3]TileL      [2,4]TileR  */
            &kp LG(UP)     &kp LG(TAB)     &tog NUM        &kp LG(LEFT)    &kp LG(RIGHT)
        /*  [3,0]Play      [3,1]Mute       [3,2]NAV-mo     [3,3]Prev       [3,4]Next   */
            &kp C_PP       &kp C_MUTE      &mo NAV         &kp C_PREV      &kp C_NEXT
        /*  [4,0]Lock      [4,1]BTL-mo     [4,2]SYS-mo     [4,3]Calc       [4,4]Email  */
            &kp LG(L)      &mo BTL         &mo SYS         &kp C_AL_CALC   &kp C_AL_EMAIL
        /*  [5,0]Web       [5,1]KpEnter    [5,2]ghost      [5,3]ghost      [5,4]ghost  */
            &kp C_AL_WWW   &kp KP_ENTER    &none           &none           &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        /* ── NUM: Numpad (toggle from DEF via NUM⊤) ───────────────────── *
         *         x=28    x=84    x=140   x=196   x=252
         * y=28:           CtlAltC ESC     BSPC    Gui+D
         * y=84:           TAB     NumLk   KP/     KP*
         * y=140:          F5      KP7     KP8     KP9
         * y=196:  NUM⊤    KP4     KP5     KP6     KP-
         * y=252:  NAV↓    KP1     KP2     KP3     KP+
         * y=308:  SYS↓    KP0     KP.     KpEnt   KP=
         * y=364:          [g]     [g]     [g]
         * Enc1(L): volume   Enc2(R): scroll
         */
        num_layer {
            bindings = <
            &kp LC(LA(C)) &kp ESC          &kp BSPC        &kp LG(D)       &kp TAB
            &kp KP_NUM    &kp KP_DIVIDE    &kp KP_MULTIPLY &kp F5          &kp KP_N7
            &kp KP_N8     &kp KP_N9        &tog NUM        &kp KP_N4       &kp KP_N5
            &kp KP_N6     &kp KP_MINUS     &mo NAV         &kp KP_N1       &kp KP_N2
            &kp KP_N3     &kp KP_PLUS      &mo SYS         &kp KP_N0       &kp KP_DOT
            &kp KP_ENTER  &kp KP_EQUAL     &none           &none           &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        /* ── NAV: F-keys + navigation (clean F1-F12 grid, realigned) ──── *
         *         x=28    x=84    x=140   x=196   x=252
         * y=28:           F1      F2      F3      F4
         * y=84:           F5      F6      F7      F8
         * y=140:          F9      F10     F11     F12
         * y=196:  ▽       HOME    UP      END     PgUp
         * y=252:  ▽held   LEFT    DOWN    RIGHT   PgDn
         * y=308:  ▽       INS     DEL     PrtSc   Enter
         * y=364:          [g]     [g]     [g]
         * Enc1(L): brightness   Enc2(R): left/right
         */
        nav_layer {
            bindings = <
            &kp F1        &kp F2           &kp F3          &kp F4          &kp F5
            &kp F6        &kp F7           &kp F8          &kp F9          &kp F10
            &kp F11       &kp F12          &trans          &kp HOME        &kp UP
            &kp END       &kp PG_UP        &trans          &kp LEFT        &kp DOWN
            &kp RIGHT     &kp PG_DN        &trans          &kp INS         &kp DEL
            &kp PSCRN     &kp ENTER        &none           &none           &none
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp RIGHT LEFT>;
        };

        /* ── BTL: Bluetooth / device-switch (hold BTL↓ on DEF) ────────── *
         * Multi-device: pair each profile to a target, then select here.
         *         x=28    x=84     x=140    x=196    x=252
         * y=28:           BT0      BT1      BT2      BT3        (abbirim/spire/pacer/hackney)
         * y=84:           BT4      OUT_USB  OUT_BLE  OUT_TOG    (BT4=spare, output route)
         * y=140:          BTclr    BTclrAll ▽        ▽
         * y=196:  ▽       ▽        ▽        ▽        ▽
         * y=252:  ▽       ▽        ▽(held)  ▽        ▽
         * y=308:  ▽       ▽        ▽        ▽        ▽
         * y=364:          [g]      [g]      [g]
         * NOTE: profiles 0-4 = the default CONFIG_ZMK_BLE_PROFILE_COUNT (5); bump
         *       murphpad.conf if you need >5 targets.
         */
        btl_layer {
            bindings = <
            &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4
            &out OUT_USB  &out OUT_BLE     &out OUT_TOG    &bt BT_CLR      &bt BT_CLR_ALL
            &trans        &trans           &trans          &trans          &trans
            &trans        &trans           &trans          &trans          &trans
            &trans        &trans           &trans          &trans          &trans
            &trans        &trans           &none           &none           &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        /* ── SYS: RGB / reset / bootloader (trimmed — BT moved to BTL) ── *
         *         x=28    x=84     x=140    x=196    x=252
         * y=28:           RGB_BRI  RGB_EFF  RGB_TOG  RGB_HUI
         * y=84:           RGB_BRD  RGB_EFR  RGB_SAI  RGB_SPI
         * y=140:          RGB_HUD  RGB_SAD  RGB_SPD  ▽
         * y=196:  ▽       ▽        ▽        ▽        sys_reset
         * y=252:  ▽       ▽        ▽(held)  ▽        bootloader
         * y=308:  ▽       ▽        ▽        ▽        ▽
         * y=364:          [g]      [g]      [g]
         */
        sys_layer {
            bindings = <
            &rgb_ug RGB_BRI &rgb_ug RGB_EFF &rgb_ug RGB_TOG &rgb_ug RGB_HUI &rgb_ug RGB_BRD
            &rgb_ug RGB_EFR &rgb_ug RGB_SAI &rgb_ug RGB_SPI &rgb_ug RGB_HUD &rgb_ug RGB_SAD
            &rgb_ug RGB_SPD &trans          &trans          &trans          &trans
            &trans          &sys_reset      &trans          &trans          &trans
            &trans          &bootloader     &trans          &trans          &trans
            &trans          &trans          &none           &none           &none
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

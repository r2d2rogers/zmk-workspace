/*
 * MurphPad — modernized keymap for zmk-workspace
 *
 * 6×5 numpad + left macro column, 2 rotary encoders.
 * nice!nano v1 (nRF52840).
 *
 * Layers:
 *   DEF  — numpad with media/macro column
 *   NAV  — navigation & F-keys
 *   SYS  — BT profiles, RGB, output toggle, bootloader
 *
 * Combos (top-left macro keys):
 *   1+2  → bootloader
 *   1+3  → sys_reset
 *   1+4  → BT next
 *   1+6  → BT clear
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define DEF 0
#define NAV 1
#define SYS 2

/* ── Encoders ─────────────────────────────────────── */
&encoder_1 { status = "okay"; };
&encoder_2 { status = "okay"; };

/* ── Combos (macro-column positions) ─────────────── */
/ {
    combos {
        compatible = "zmk,combos";

        combo_bootloader {
            timeout-ms = <300>;
            key-positions = <0 5>;   /* row0col0 + row1col0 */
            bindings = <&bootloader>;
        };

        combo_reset {
            timeout-ms = <300>;
            key-positions = <0 10>;  /* row0col0 + row2col0 */
            bindings = <&sys_reset>;
        };

        combo_bt_nxt {
            timeout-ms = <300>;
            key-positions = <0 15>;  /* row0col0 + row3col0 */
            bindings = <&bt BT_NXT>;
        };

        combo_bt_clr {
            timeout-ms = <300>;
            key-positions = <0 25>;  /* row0col0 + row5col0 */
            bindings = <&bt BT_CLR>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_layer {
            if-layers = <NAV>;
            then-layer = <SYS>;
        };
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1 &encoder_2>;
    };

    keymap {
        compatible = "zmk,keymap";

        /* ── DEF: Numpad ─────────────────────────── */
        default_layer {
            bindings = <
        /*  macro col     col1          col2           col3             col4          */
            &kp N1        &kp TAB       &kp F5         &kp LC(LA(C))    &kp LG(D)
            &kp N2        &kp ESC       &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS
            &kp N3        &kp KP_N7     &kp KP_N8      &kp KP_N9        &kp KP_PLUS
            &kp C_MUTE    &kp KP_N4     &kp KP_N5      &kp KP_N6        &kp KP_ENTER
            &mo NAV       &kp KP_N1     &kp KP_N2      &kp KP_N3        &kp KP_ENTER
            &mo SYS       &kp KP_N0     &none          &kp KP_DOT       &kp C_PP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        /* ── NAV: Navigation & F-keys ────────────── */
        nav_layer {
            bindings = <
            &trans        &kp F1        &kp F2         &kp F3           &kp F4
            &trans        &kp F5        &kp F6         &kp F7           &kp F8
            &trans        &kp HOME      &kp UP         &kp END          &kp PG_UP
            &trans        &kp LEFT      &kp DOWN       &kp RIGHT        &kp PG_DN
            &trans        &kp INS       &kp DEL        &kp PSCRN        &kp ENTER
            &trans        &kp CAPS      &none          &kp KP_NUM  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp RIGHT LEFT>;
        };

        /* ── SYS: Bluetooth, RGB, Output ─────────── */
        sys_layer {
            bindings = <
            &trans        &rgb_ug RGB_EFF &out OUT_USB  &out OUT_BLE     &out OUT_TOG
            &trans        &rgb_ug RGB_TOG &rgb_ug RGB_HUI &rgb_ug RGB_SAI &bt BT_CLR
            &trans        &bt BT_SEL 7  &bt BT_SEL 8   &bt BT_SEL 9     &none
            &none         &bt BT_SEL 4  &bt BT_SEL 5   &bt BT_SEL 6     &none
            &trans        &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3     &sys_reset
            &trans        &bt BT_SEL 0  &none          &none             &bootloader
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

#define CONFIG_WIRELESS
#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH)                   \
    ZMK_LAYER(                                                                 \
        name,                                                                  \
        &kp TAB        LT RT               &kp BSLH                            \
        &mt LCTRL ESC  LM RM               &kp SQT                             \
        &kp LSHFT      LB RB               &kp RSHFT                           \
        &kp LGUI       LH RH &smart_mouse                                      \
    )

#include "zmk-helpers/key-labels/42.h"
#include "dt-bindings/zmk/outputs.h"
#include "dt-bindings/zmk/ext_power.h"
#include "dt-bindings/zmk/rgb.h"

&spi3 {
  led_strip: ws2812@0 {
    /* WS2812 */
    chain-length = <27>; /* There are per-key RGB, but the first 6 are underglow */
  };
};
#include "base.keymap"

/{ chosen { zmk,physical-layout = &foostan_corne_6col_layout; }; };

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    /*
     * MATRIX kscan. Converting from direct-wire frees GPIO for the
     * analog sticks + encoders.
     *
     * Per half we need to address:
     *   15 alpha/thumb keys ... wait, recount:
     *     outer[5] + home[5] + inner[5] = 15 keys
     *     + 1 thumb                     = 16 keys
     *     + 1 scroll-wheel click        = 17
     *     + 1 thumbstick click          = 18
     *   -> a 4x5 matrix = 20 cells covers 18 with 2 spare.
     *   Cost: 4 row pins + 5 col pins = 9 GPIO/side (vs 16 direct).
     *   Add 1N4148 diodes col->row (diode-direction = "col2row").
     *
     * Freed budget/side: ~16-18 usable - 9 matrix = 7-9 pins for:
     *   encoder A/B (2) + stick ADC X/Y (2) = 4. Comfortable.
     */
    kscan0: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        /* row-gpios / col-gpios provided per-half in the .overlay */
    };

    /* Rotary encoder (scroll wheel). Native ZMK. A/B pins per half. */
    wheel: encoder_wheel {
        compatible = "alps,ec11";
        steps = <80>;
        status = "disabled";   /* enabled + given gpios in each overlay */
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&wheel>;
        triggers-per-rotation = <20>;
    };

    /*
     * Physical layout / transform. 10 columns x 4 rows across the whole
     * keyboard for keymap ergonomics (left cols 0-4, right cols 5-9).
     * Thumb on row 3. Clicks are NOT in the visual layout (they live in
     * the matrix but are bound via the encoder/stick, not as grid keys)
     * — they're handled by behaviors, so the keymap grid stays 32.
     */
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "backkb";
        transform = <&default_transform>;
    };

    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                        RC(3,4)                   RC(3,5)
        >;
    };
};
